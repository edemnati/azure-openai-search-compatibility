AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
AZURE_SEARCH_SEMANTIC_CONFIGURATION=<semantic-configuration>
AZURE_SEARCH_CONTENT_FIELDS=content
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_URL_FIELD=url
AZURE_SEARCH_VECTOR_FIELDS=contentVector
AZURE_SEARCH_QUERY_TYPE=semantic
AZURE_SEARCH_STRICTNESS=3
AZURE_SEARCH_TOP_N_DOCUMENTS=5
AZURE_SEARCH_IN_SCOPE=true

# Optional test-only helper. When true, load-env.ps1 retrieves the key into process
# memory. Do not put the key itself in this file.
AZURE_SEARCH_USE_ADMIN_KEY=false
AZURE_SEARCH_SERVICE_NAME=<search-service>
AZURE_SEARCH_RESOURCE_GROUP=<resource-group>

TEST_QUERY=<question-with-a-known-answer>
EXPECTED_TEXT=<text-that-must-appear-in-the-answer>

AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
